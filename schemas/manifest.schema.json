{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daydrift-docs.blym.top/schemas/manifest.schema.json",
  "title": "DaydriftModManifest",
  "description": "《度日：Daydrift》模组元数据清单规范",
  "type": "object",
  "required": ["id", "name", "version", "author", "description", "type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "模组唯一标识符（全小写字母、数字、下划线或连字符，1-64字符）"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "模组展示名称"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "语义化版本号 (SemVer, 如 1.0.0)"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "作者署名"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "模组简介与功能描述"
    },
    "type": {
      "type": "string",
      "enum": ["data", "lua", "native"],
      "description": "模组架构分流体系：'data' (纯数据), 'lua' (脚本沙盒), 'native' (原生PCK)"
    },
    "entry": {
      "type": "string",
      "description": "模组主入口文件相对路径（例如 narrative/slice.json, scripts/main.lua 或 entry.gd）"
    },
    "priority": {
      "type": "integer",
      "default": 0,
      "description": "加载权重，数值越大越先加载"
    },
    "net_sync_mode": {
      "type": "string",
      "enum": ["client_only", "server_only", "two_way", "optional"],
      "default": "client_only",
      "description": "多端联机同步模式"
    },
    "preview": {
      "type": "string",
      "description": "模组预览图相对路径 (如 preview.webp, preview.png)"
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "模组主页或源码仓库网址"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "前置依赖的模组 ID 列表"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "scene_tampering",
          "ui_mounting",
          "network_packet",
          "save_tampering",
          "file_access",
          "audio_playback"
        ]
      },
      "description": "模组申请的高级权限声明"
    }
  },
  "additionalProperties": true
}
